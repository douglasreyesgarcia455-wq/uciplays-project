<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/frontend/css/inicio.css">
    <link rel="stylesheet" href="/frontend/css/ranking.css">
    <script src="/backend/js/formulario.js" defer></script>
    <link rel="shortcut icon" href="/assets/favicon/favicon.png" type="image/x-icon">
    <title>Ranking - JUMP</title>
</head>
<body>

    <!-- HEADER (Navegación) -->
    <header class="header">
        <div class="header__container">
            <a class="header__brand" href="index.html" aria-label="JUMP, ir al inicio">
                <img class="header__logo header__logo--light" src="/assets/Logo/JUMP_logo oscuro.png" alt="">
            </a>

            <nav class="header__nav" aria-label="Navegación principal">
                <ul class="header__nav-list">
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="index.html">Inicio</a>
                    </li>
                    <li class="header__nav-item">
                        <!-- Clase activa movida a Ranking -->
                        <a class="header__nav-link header__nav-link--active" href="ranking.html" aria-current="page">Ranking</a>
                    </li>
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="cartelera.html">Cartelera</a>
                    </li>
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="estadisticas.html">Estadísticas</a>
                    </li>
                </ul>
            </nav>

            <a class="header__admin-link" href="acceso-administracion.html">
                <span class="header__admin-label">Administración</span>
                <span class="header__admin-icon" aria-hidden="true">
                    <svg class="header__admin-icon-svg" viewBox="0 0 24 24" fill="none">
                        <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL: RANKING -->
    <main class="main">
        <div class="ranking">
            <h1 class="ranking__titulo">Tabla de Puntuación General</h1>
            
            <div class="ranking__tabla-contenedor">
                <table class="ranking__tabla">
                    <thead>
                        <tr>
                            <!-- Columnas basadas estrictamente en la clase CE_Tabla_puntuación -->
                            <th>Posición</th>
                            <th class="text-left">Facultad</th>
                            <th>Oro</th>
                            <th>Plata</th>
                            <th>Bronce</th>
                            <th>4to</th>
                            <th>5to</th>
                            <th>Total Eventos</th>
                            <th>Puntos</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Fila de ejemplo 1 -->
                        <tr>
                            <td class="ranking__posicion">1</td>
                            <td>
                                <div class="ranking__facultad">
                                    <!-- Espacio reservado para el logo -->
                                    <img class="ranking__logo" src="/assets/logos/fei-logo.png" alt="Logo">
                                    <span class="ranking__nombre">FEI</span>
                                </div>
                            </td>
                            <td>2</td>
                            <td>1</td>
                            <td>0</td>
                            <td>0</td>
                            <td>0</td>
                            <td>3</td>
                            <td class="ranking__puntos-total">77</td>
                        </tr>
                        
                        <!-- Fila de ejemplo 2 -->
                        <tr>
                            <td class="ranking__posicion">2</td>
                            <td>
                                <div class="ranking__facultad">
                                    <img class="ranking__logo" src="/assets/logos/fte-logo.png" alt="Logo">
                                    <span class="ranking__nombre">FTE</span>
                                </div>
                            </td>
                            <td>1</td>
                            <td>0</td>
                            <td>1</td>
                            <td>1</td>
                            <td>0</td>
                            <td>3</td>
                            <td class="ranking__puntos-total">40</td>
                        </tr>

                        <!-- Fila 3: FICI -->
<tr>
    <td class="ranking__posicion">3</td>
    <td>
        <div class="ranking__facultad">
            <img class="ranking__logo" src="/assets/logos/fici-logo.png" alt="Logo">
            <span class="ranking__nombre">FICI</span>
        </div>
    </td>
    <td>0</td>
    <td>1</td>
    <td>1</td>
    <td>0</td>
    <td>0</td>
    <td>2</td>
    <td class="ranking__puntos-total">22</td>
</tr>

<!-- Fila 4: CITI -->
<tr>
    <td class="ranking__posicion">4</td>
    <td>
        <div class="ranking__facultad">
            <img class="ranking__logo" src="/assets/logos/citi-logo.png" alt="Logo">
            <span class="ranking__nombre">CITI</span>
        </div>
    </td>
    <td>0</td>
    <td>0</td>
    <td>2</td>
    <td>1</td>
    <td>0</td>
    <td>3</td>
    <td class="ranking__puntos-total">16</td>
</tr>

<!-- Fila 5: FCE -->
<tr>
    <td class="ranking__posicion">5</td>
    <td>
        <div class="ranking__facultad">
            <img class="ranking__logo" src="/assets/logos/fce-logo.png" alt="Logo">
            <span class="ranking__nombre">FCE</span>
        </div>
    </td>
    <td>0</td>
    <td>0</td>
    <td>0</td>
    <td>2</td>
    <td>2</td>
    <td>4</td>
    <td class="ranking__puntos-total">6</td>
</tr>

<!-- Fila 6: FTI -->
<tr>
    <td class="ranking__posicion">6</td>
    <td>
        <div class="ranking__facultad">
            <img class="ranking__logo" src="/assets/logos/fti-logo.png" alt="Logo">
            <span class="ranking__nombre">FTI</span>
        </div>
    </td>
    <td>0</td>
    <td>0</td>
    <td>0</td>
    <td>0</td>
    <td>1</td>
    <td>1</td>
    <td class="ranking__puntos-total">1</td>
</tr>
                    </tbody>
                </table>
            </div>

            <!-- Leyenda basada en las reglas del negocio de puntuación -->
            <div class="ranking__leyenda">
                <strong>Sistema de puntuación oficial:</strong> Oro (31 pts) • Plata (15 pts) • Bronce (7 pts) • 4to lugar (2 pts) • 5to lugar (1 pt).
            </div>
        </div>
    </main>


    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer__container">
            
            <!-- Espacio para Logo Izquierdo (Logo principal) -->
            <a class="footer__brand footer__brand--izq" href="index.html" aria-label="Ir al inicio">
                <img class="footer__logo" src="/assets/Logo/JUMP_logo claro.png" alt="Logo JUMP">
            </a>

            <!-- Enlaces Centrales -->
            <nav class="footer__nav" aria-label="Navegación del pie de página">
                <ul class="footer__nav-list">
                    <li class="footer__nav-item"><a class="footer__nav-link" href="index.html">Inicio</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="ranking.html">Ranking</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="cartelera.html">Cartelera</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="estadisticas.html">Estadísticas</a></li>
                </ul>
            </nav>

            <!-- Espacio para Logo Derecho (Universidad, facultad, patrocinador, etc.) -->
            <a class="footer__brand footer__brand--der" href="index.html" aria-label="Ir al inicio">
                <img class="footer__logo" src="/assets/Logo/Logo Uci mor.png" alt="Logo UCI">
            </a>

        </div>
    </footer>

    <!-- VENTANA MODAL DE ADMINISTRACIÓN -->
<div class="modal-admin" id="modal-admin">
    <div class="modal-admin__contenido">
        <button class="modal-admin__cerrar" id="btn-cerrar-admin" aria-label="Cerrar ventana">&times;</button>
        <h2 class="modal-admin__titulo">Solo Administración</h2>
        
        <form class="modal-admin__form" id="form-admin">
            <div class="modal-admin__grupo">
                <label for="admin-user" class="modal-admin__label">Usuario</label>
                <input type="text" id="admin-user" class="modal-admin__input" required placeholder="Ingresa tu usuario">
            </div>
            
            <div class="modal-admin__grupo">
                <label for="admin-pass" class="modal-admin__label">Contraseña</label>
                <input type="password" id="admin-pass" class="modal-admin__input" required placeholder="Ingresa tu contraseña">
            </div>
            
            <button type="submit" class="modal-admin__btn-submit">Ingresar</button>
        </form>
    </div>
</div>

</body>
</html>