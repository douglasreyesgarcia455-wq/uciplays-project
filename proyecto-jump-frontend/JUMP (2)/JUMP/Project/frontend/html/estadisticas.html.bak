<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/frontend/css/inicio.css">
    <link rel="stylesheet" href="/frontend/css/estadisticas.css">
    <script src="/backend/js/estadisticas.js" defer></script>
    <script src="/backend/js/formulario.js" defer></script>
    <link rel="shortcut icon" href="/assets/favicon/favicon.png" type="image/x-icon">
    <!-- Librería Chart.js para dibujar los gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>Estadísticas - JUMP</title>
</head>
<body>

    <!-- HEADER (Navegación) -->
    <header class="header">
        <div class="header__container">
            <a class="header__brand" href="index.html" aria-label="JUMP, ir al inicio">
                <img class="header__logo header__logo--light" src="/assets/Logo/JUMP_logo oscuro.png" alt="">
            </a>

            <nav class="header__nav" aria-label="Navegación principal">
                <ul class="header__nav-list">
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="index.html">Inicio</a>
                    </li>
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="ranking.html">Ranking</a>
                    </li>
                    <li class="header__nav-item">
                        <a class="header__nav-link" href="cartelera.html">Cartelera</a>
                    </li>
                    <li class="header__nav-item">
                        <!-- Clase activa movida a Estadísticas -->
                        <a class="header__nav-link header__nav-link--active" href="estadisticas.html" aria-current="page">Estadísticas</a>
                    </li>
                </ul>
            </nav>

            <a class="header__admin-link" href="acceso-administracion.html">
                <span class="header__admin-label">Administración</span>
                <span class="header__admin-icon" aria-hidden="true">
                    <svg class="header__admin-icon-svg" viewBox="0 0 24 24" fill="none">
                        <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
            </a>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main">
        <div class="estadisticas-contenedor">
            <h1 class="estadisticas__titulo">Análisis de Rendimiento</h1>
            
            <!-- PANEL DE FILTROS (RF 29) -->
            <div class="estadisticas__filtros">
                <div class="estadisticas__filtro-grupo">
                    <label for="filtro-deporte">Filtrar por Deporte:</label>
                    <select id="filtro-deporte" class="estadisticas__select">
                        <option value="todos">Todos los deportes</option>
                        <option value="futbol">Fútbol</option>
                        <option value="volleyball">Volleyball</option>
                        <option value="beisbol">Béisbol</option>
                    </select>
                </div>
                <div class="estadisticas__filtro-grupo">
                    <label for="filtro-facultad">Comparar Facultades:</label>
                    <select id="filtro-facultad" class="estadisticas__select">
                        <option value="todas">Todas las facultades</option>
                        <option value="top3">Top 3 del Ranking</option>
                    </select>
                </div>
            </div>

            <!-- TARJETAS DE RESUMEN -->
<div class="estadisticas__resumen">
    <div class="estadisticas__card">
        <h3>Total Partidos</h3>
        <p class="estadisticas__valor">42</p>
    </div>
    <div class="estadisticas__card">
        <h3>Facultad Líder</h3>
        <div class="estadisticas__valor">
            <!-- Reemplazamos el texto "FEI" por su logo -->
            <img class="estadisticas__logo" src="/assets/logos/fei-logo.png" alt="Logo FEI">
        </div>
    </div>
    <div class="estadisticas__card">
        <h3>Mayor Participación</h3>
        <div class="estadisticas__valor">
            <!-- Reemplazamos el texto "FTE" por su logo -->
            <img class="estadisticas__logo" src="/assets/logos/fte-logo.png" alt="Logo FTE">
        </div>
    </div>
</div>

            <!-- CONTENEDORES DE GRÁFICOS (RF 28) -->
            <!-- CONTENEDORES DE GRÁFICOS -->
<div class="estadisticas__graficos">
    
    <!-- 1. Desglose de Puntos por Disciplina (Ancho completo) -->
    <div class="estadisticas__grafico-caja estadisticas__grafico-caja--full">
        <h2 class="estadisticas__grafico-titulo">Desglose de Puntos por Disciplina</h2>
        <canvas id="graficoDesglose"></canvas>
    </div>

    <!-- 2. Eficiencia en el Podio (Ratio de Oro) -->
    <div class="estadisticas__grafico-caja">
        <h2 class="estadisticas__grafico-titulo">Eficiencia en el Podio (Medallas de Oro)</h2>
        <canvas id="graficoEficiencia"></canvas>
    </div>

    <!-- 3. Índice de Disciplina (Penalizaciones) -->
    <div class="estadisticas__grafico-caja">
        <h2 class="estadisticas__grafico-titulo">Índice de Disciplina (Sanciones)</h2>
        <canvas id="graficoDisciplina"></canvas>
    </div>

    <!-- 4. Análisis Frente a Frente (Head-to-Head) -->
    <div class="estadisticas__grafico-caja">
        <div class="estadisticas__h2h-header">
            <h2 class="estadisticas__grafico-titulo">Frente a Frente</h2>
            <div class="estadisticas__h2h-selectores">
                <select class="estadisticas__select"><option>FEI</option></select>
                <span>vs</span>
                <select class="estadisticas__select"><option>FTE</option></select>
            </div>
        </div>
        <canvas id="graficoH2H"></canvas>
    </div>

    <!-- 5. Impacto Logístico (Tasa de Suspensión) -->
    <div class="estadisticas__grafico-caja">
        <h2 class="estadisticas__grafico-titulo">Tasa de Suspensión por Deporte</h2>
        <canvas id="graficoLogistica"></canvas>
    </div>

</div>
        </div>
    </main>


    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer__container">
            
            <!-- Espacio para Logo Izquierdo (Logo principal) -->
            <a class="footer__brand footer__brand--izq" href="index.html" aria-label="Ir al inicio">
                <img class="footer__logo" src="/assets/Logo/JUMP_logo claro.png" alt="Logo JUMP">
            </a>

            <!-- Enlaces Centrales -->
            <nav class="footer__nav" aria-label="Navegación del pie de página">
                <ul class="footer__nav-list">
                    <li class="footer__nav-item"><a class="footer__nav-link" href="index.html">Inicio</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="ranking.html">Ranking</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="cartelera.html">Cartelera</a></li>
                    <li class="footer__nav-item"><a class="footer__nav-link" href="estadisticas.html">Estadísticas</a></li>
                </ul>
            </nav>

            <!-- Espacio para Logo Derecho (Universidad, facultad, patrocinador, etc.) -->
            <a class="footer__brand footer__brand--der" href="index.html" aria-label="Ir al inicio">
                <img class="footer__logo" src="/assets/Logo/Logo Uci mor.png" alt="Logo UCI">
            </a>

        </div>
    </footer>

    <!-- VENTANA MODAL DE ADMINISTRACIÓN -->
<div class="modal-admin" id="modal-admin">
    <div class="modal-admin__contenido">
        <button class="modal-admin__cerrar" id="btn-cerrar-admin" aria-label="Cerrar ventana">&times;</button>
        <h2 class="modal-admin__titulo">Solo Administración</h2>
        
        <form class="modal-admin__form" id="form-admin">
            <div class="modal-admin__grupo">
                <label for="admin-user" class="modal-admin__label">Usuario</label>
                <input type="text" id="admin-user" class="modal-admin__input" required placeholder="Ingresa tu usuario">
            </div>
            
            <div class="modal-admin__grupo">
                <label for="admin-pass" class="modal-admin__label">Contraseña</label>
                <input type="password" id="admin-pass" class="modal-admin__input" required placeholder="Ingresa tu contraseña">
            </div>
            
            <button type="submit" class="modal-admin__btn-submit">Ingresar</button>
        </form>
    </div>
</div>

</body>
</html>